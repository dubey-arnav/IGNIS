# IGNIS Production Environment Configuration

# Database Settings
DB_HOST=db
DB_PORT=5432
DB_NAME=IGNIS
DB_USER=postgres
DB_PASSWORD=your_strong_postgres_password_here

# External APIs
FIRMS_MAP_KEY=your_nasa_firms_map_key_here
SENTINEL_CLIENT_ID=your_sentinel_client_id_here
SENTINEL_CLIENT_SECRET=your_sentinel_client_secret_here

# Automation & Near Real-Time Settings
AUTOMATION_LOOKBACK_DAYS=2
AUTOMATION_INTERVAL_MINUTES=30
AUTOMATION_LOG_LEVEL=INFO
FIRMS_BBOX=68,6,97,37

# Frontend & CORS
CORS_ORIGINS=*

# Optional: Cloudflare Tunnel Token (for 100% free permanent HTTPS domain without opening ports)
CLOUDFLARE_TUNNEL_TOKEN=
